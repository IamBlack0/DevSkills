{
  "name": "devskills",
  "version": "1.0.0",
  "description": "Skills & MCPs para tu terminal — navega, aprende y copia",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "devskills": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('../../content','dist/content',{recursive:true}); console.log('content/ bundled into dist/');\"",
    "build:watch": "tsc --watch",
    "prepack": "pnpm build",
    "lint": "echo 'no linter configured'",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "gray-matter": "^4.0.3",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
