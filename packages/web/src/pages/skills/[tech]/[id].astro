---
import IDELayout from '../../../layouts/IDELayout.astro';
import Icon from '../../../components/Icon.astro';
import { getTechnologies, getSkillsForTech } from '../../../utils/catalog';
import { renderMarkdown } from '../../../utils/markdown';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  const techs = getTechnologies();
  return techs.flatMap(tech =>
    getSkillsForTech(tech.id).map(skill => ({
      params: { tech: tech.id, id: skill.id },
      props: { skill, tech },
    }))
  );
};

const { skill, tech } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const htmlContent = renderMarkdown(skill.content);
---

<IDELayout title={skill.title} description={skill.description} type="article" currentPath={`skills/${tech.id}/${skill.id}.md`}>
  <slot slot="tabs">
    <a
      href={`${base}/skills/${tech.id}`}
      class="flex items-center gap-2 px-4 py-2 bg-ide-tabs border-r border-ide-border text-xs text-ide-textDim hover:text-ide-text transition-colors"
    >
      {tech.svgUrl
        ? <img src={tech.svgUrl} width="12" height="12" alt={tech.label} />
        : <span class="text-[10px]">{tech.icon}</span>
      }
      <span>{tech.id}/</span>
    </a>
    <div class="flex items-center gap-2 px-4 py-2 bg-ide-tabActive border-r border-ide-border text-xs text-ide-text border-t-2 border-t-ide-accent">
      <Icon name="file" size={11} class="text-ide-textDim" />
      <span>{skill.id}.md</span>
      <button
        class="ml-1 text-ide-textDim hover:text-ide-text transition-colors"
        onclick="history.back()"
        data-i18n="cerrar"
      >×</button>
    </div>
  </slot>

  <div class="p-6 max-w-3xl" x-data="{ copied: false }">
    <!-- Toolbar -->
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-2 text-xs text-ide-textDim">
        <a href={`${base}/skills/${tech.id}`} class="hover:text-ide-text transition-colors">{tech.id}</a>
        <span>/</span>
        <span class="text-ide-text">{skill.id}.md</span>
        {skill.source && (
          <>
            <span class="text-ide-textMuted">|</span>
            <a
              href={skill.source}
              target="_blank"
              rel="noopener"
              class="text-ide-accent hover:underline flex items-center gap-1"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              repo
            </a>
          </>
        )}
      </div>

      <div class="flex items-center gap-2">
        {skill.tags.map(tag => (
          <span class="text-[10px] bg-ide-tabs border border-ide-border rounded px-1.5 py-0.5 text-ide-comment">{tag}</span>
        ))}
        <button
          class="flex items-center gap-1.5 text-xs border border-ide-border rounded px-3 py-1.5 text-ide-textDim hover:text-ide-accent hover:border-ide-accent transition-colors"
          :class="copied ? 'text-ide-string border-ide-string' : ''"
          @click={`navigator.clipboard.writeText(${JSON.stringify(skill.content)}).then(() => { copied = true; setTimeout(() => copied = false, 2000) })`}
        >
          <span x-show="!copied" class="flex items-center gap-1" data-i18n="copiar">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            Copy
          </span>
          <span x-show="copied" x-cloak class="flex items-center gap-1" data-i18n="copiado">
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            Copiado
          </span>
        </button>
      </div>
    </div>

    <!-- Markdown content -->
    <article class="prose-ide" set:html={htmlContent} />
  </div>
</IDELayout>
