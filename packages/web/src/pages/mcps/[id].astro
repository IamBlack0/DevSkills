---
import IDELayout from '../../layouts/IDELayout.astro';
import Icon from '../../components/Icon.astro';
import { getMCPs } from '../../utils/catalog';
import { fetchGitHubStats, formatStars, formatDate } from '../../utils/github';
import { renderMarkdown } from '../../utils/markdown';

export async function getStaticPaths() {
  const mcps = getMCPs();

  // Fetch de datos GitHub en paralelo (build-time)
  const entries = await Promise.all(
    mcps.map(async mcp => {
      const gh = await fetchGitHubStats(mcp.repo);
      return {
        params: { id: mcp.id },
        props: {
          mcp,
          stars:     gh?.stars   ?? mcp.stars,
          updatedAt: gh?.pushedAt ?? null,
        },
      };
    })
  );

  return entries;
}

const { mcp, stars, updatedAt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const htmlContent = renderMarkdown(mcp.content);
const htmlContentEn = mcp.contentEn ? renderMarkdown(mcp.contentEn) : htmlContent;
const starsDisplay = formatStars(stars);
const updatedDisplay = updatedAt ? formatDate(updatedAt) : null;
---

<IDELayout title={mcp.title} description={mcp.description} type="article" currentPath={`mcps/${mcp.id}.md`}>
  <slot slot="tabs">
    <a
      href={`${base}/mcps`}
      class="flex items-center gap-2 px-4 py-2 bg-ide-tabs border-r border-ide-border text-xs text-ide-textDim hover:text-ide-text transition-colors"
    >
      <Icon name="package" size={11} />
      <span data-i18n="mcps_dir">mcps/</span>
    </a>
    <div class="flex items-center gap-2 px-4 py-2 bg-ide-tabActive border-r border-ide-border text-xs text-ide-text border-t-2 border-t-ide-accentSecondary">
      <img src="https://cdn.simpleicons.org/modelcontextprotocol/white" width="12" height="12" alt="MCP" class="shrink-0" />
      <span>{mcp.id}.md</span>
    </div>
  </slot>

  <div class="p-6 max-w-3xl" x-data="{ copied: false }">
    <!-- MCP Header Card -->
    <div class="bg-ide-sidebar border border-ide-border rounded-lg p-5 mb-6">
      <h1 class="text-base font-bold text-ide-accentSecondary mb-1">{mcp.title}</h1>
      <p class="text-sm text-ide-textDim mb-4">
        <span class="lang-es">{mcp.description}</span>
        <span class="lang-en" style="display:none">{mcp.descriptionEn ?? mcp.description}</span>
      </p>

      <div class="space-y-2 text-xs">
        <!-- Repo -->
        <div class="flex items-center gap-2">
          <span class="text-ide-textDim w-24 shrink-0" data-i18n="repositorio">Repositorio</span>
          <a
            href={mcp.repo}
            target="_blank"
            rel="noopener"
            class="text-ide-accent hover:underline flex items-center gap-1"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            {mcp.repo.replace('https://github.com/', '')}
          </a>
        </div>

        <!-- Autor + Estrellas (tiempo real) + Última actualización -->
        <div class="flex items-center gap-4">
          <span class="text-ide-textDim w-24 shrink-0" data-i18n="autor">Autor</span>
          <span class="text-ide-text">{mcp.author}</span>
          <span class="flex items-center gap-1 text-ide-comment">
            <Icon name="star" size={11} />
            <span>{starsDisplay}</span>
          </span>
          {updatedDisplay && (
            <span class="text-ide-textMuted flex items-center gap-1" title={updatedAt ?? ''}>
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {updatedDisplay}
            </span>
          )}
        </div>

        <!-- Clientes -->
        <div class="flex items-center gap-2">
          <span class="text-ide-textDim w-24 shrink-0" data-i18n="clientes">Clientes</span>
          <div class="flex gap-1 flex-wrap">
            {mcp.clients.map(c => (
              <span class="bg-ide-tabs border border-ide-border rounded px-1.5 py-0.5 text-ide-textDim">{c}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Comando de instalación -->
      <div class="mt-4 pt-4 border-t border-ide-border">
        <div class="text-xs text-ide-textDim mb-2" data-i18n="instalacion">Instalación:</div>
        <div class="flex items-center gap-2 bg-ide-bg rounded px-3 py-2">
          <span class="text-ide-comment text-xs select-none">$</span>
          <code class="text-ide-string text-xs flex-1 font-mono">{mcp.install}</code>
          <button
            class="flex items-center gap-1 text-xs text-ide-textDim hover:text-ide-accent border border-ide-border rounded px-2 py-1 transition-colors shrink-0"
            :class="copied ? 'text-ide-string border-ide-string' : ''"
            @click={`navigator.clipboard.writeText(${JSON.stringify(mcp.install)}).then(() => { copied = true; setTimeout(() => copied = false, 2000) })`}
          >
            <span x-show="!copied" class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <span data-i18n="copiar">Copiar</span>
            </span>
            <span x-show="copied" x-cloak class="flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span data-i18n="ok">OK</span>
            </span>
          </button>
        </div>
      </div>
    </div>

    <!-- Contenido markdown (tablas + code con syntax highlighting) -->
    <article class="prose-ide lang-es" set:html={htmlContent} />
    <article class="prose-ide lang-en" style="display:none" set:html={htmlContentEn} />
  </div>
</IDELayout>
