---
import IDELayout from '../../layouts/IDELayout.astro';
import { getMCPs } from '../../utils/catalog';

const mcps = getMCPs();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const clientFilters = ['todos', 'claude-code', 'cursor', 'vscode', 'opencode'];
const categoryFilters = [...new Set(mcps.map(m => m.category))];
---

<IDELayout title="MCPs" description="Herramientas MCP (Model Context Protocol) para agentes IA — Context7, Fetch, Filesystem, Memory, GitHub, Playwright y más." currentPath="mcps/">
  <slot slot="tabs">
    <a
      href={`${base}/mcps`}
      class="flex items-center gap-2 px-4 py-2 bg-ide-tabActive border-r border-ide-border text-xs text-ide-text border-t-2 border-t-ide-accentSecondary"
    >
      <img src="https://cdn.simpleicons.org/modelcontextprotocol/white" width="13" height="13" alt="MCP" class="shrink-0" />
      <span>mcps/</span>
    </a>
  </slot>

  <div class="p-6" x-data={`{ client: 'todos', category: 'todos' }`}>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-xl font-bold text-ide-accentSecondary mb-1">MCPs</h1>
        <p class="text-xs text-ide-textDim" data-i18n="mcps_subtitle">Herramientas para agentes IA — verificadas y con repositorio</p>
      </div>
      <span class="text-xs text-ide-textDim bg-ide-sidebar border border-ide-border rounded px-2 py-1">
        {mcps.length} <span data-i18n="herramientas">herramientas</span>
      </span>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-2 mb-6">
      <div class="flex items-center gap-1">
        <span class="text-xs text-ide-textDim mr-1" data-i18n="cliente">Cliente:</span>
        {clientFilters.map(f => (
          <button
            @click={`client = '${f}'`}
            :class={`client === '${f}' ? 'border-ide-accentSecondary text-ide-text' : 'border-ide-border text-ide-textDim hover:border-ide-textDim'`}
            class="text-xs border rounded px-2 py-1 transition-colors"
          >
            {f}
          </button>
        ))}
      </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 gap-3 max-w-2xl">
      {mcps.map(mcp => (
        <a
          href={`${base}/mcps/${mcp.id}`}
          x-show={`client === 'todos' || ${JSON.stringify(mcp.clients)}.includes(client)`}
          class="group block bg-ide-sidebar border border-ide-border rounded-lg p-4 hover:border-ide-accentSecondary transition-colors"
          data-search
          data-search-title={mcp.title}
          data-search-type="mcp"
          data-search-hint={mcp.author}
        >
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-sm font-medium text-ide-text group-hover:text-ide-accentSecondary transition-colors">
                  {mcp.title}
                </span>
                <span class="text-xs text-ide-comment">⭐ {mcp.stars.toLocaleString()}</span>
              </div>
              <p class="text-xs text-ide-textDim mb-2">{mcp.description}</p>
              <div class="flex items-center gap-2 flex-wrap">
                <a
                  href={mcp.repo}
                  target="_blank"
                  rel="noopener"
                  class="text-xs text-ide-accent hover:underline"
                  onclick="event.stopPropagation()"
                >
                  ↗ {mcp.repo.replace('https://github.com/', '')}
                </a>
                <span class="text-ide-textMuted">·</span>
                <span class="text-xs text-ide-textDim">{mcp.author}</span>
              </div>
            </div>
            <div class="flex flex-col gap-1 shrink-0">
              {mcp.clients.map(c => (
                <span class="text-[9px] bg-ide-tabs border border-ide-border rounded px-1.5 py-0.5 text-ide-textDim">
                  {c}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</IDELayout>
